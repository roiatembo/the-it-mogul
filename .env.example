# =============================================================================
# The IT Mogul — WordPress Environment Configuration
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your local environment.
#
#   cp .env.example .env
#
# NEVER commit the real `.env` file. It contains secrets and is git-ignored.
#
# In all environments the following files are loaded if they exist, the latter
# taking precedence over the former:
#
#   * .env          contains default values for the environment variables
#   * .env.local    uncommitted file with local overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILE.
# =============================================================================

# -----------------------------------------------------------------------------
# Project / Docker
# -----------------------------------------------------------------------------

# Which version of PHP would you like to use? Major and minor only, e.g. 8.2 or 8.3.
PHP_VERSION=8.3

# WordPress version to install (used by the install script).
WORDPRESS_VERSION=6.7

# A docker network is required to ensure the loopback works as expected.
DOCKER_NETWORK_NAME=it-mogul-docker

# Project name is used in various places such as the site URL and text domain.
PROJECT_NAME=it-mogul

# -----------------------------------------------------------------------------
# Environment type
# -----------------------------------------------------------------------------
# See https://make.wordpress.org/core/2020/08/27/wordpress-environment-types/
# Valid values: local, development, staging, production
WP_ENVIRONMENT_TYPE=local

# -----------------------------------------------------------------------------
# Site config
# -----------------------------------------------------------------------------

WP_HOME=https://${PROJECT_NAME}.local
WP_DIR=wp

# -----------------------------------------------------------------------------
# Database config
# -----------------------------------------------------------------------------

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=__SECRET__
DB_ROOT_PASSWORD=__SECRET__
DB_HOST=localhost
DB_CHARSET=utf8
DB_COLLATE=
DB_TABLE_PREFIX=wp_

# -----------------------------------------------------------------------------
# Authentication unique keys and salts
# -----------------------------------------------------------------------------
# Generate these using https://api.wordpress.org/secret-key/1.1/salt/
# These are SECRETS. Never commit real values.

AUTH_KEY=__SECRET__
SECURE_AUTH_KEY=__SECRET__
LOGGED_IN_KEY=__SECRET__
NONCE_KEY=__SECRET__
AUTH_SALT=__SECRET__
SECURE_AUTH_SALT=__SECRET__
LOGGED_IN_SALT=__SECRET__
NONCE_SALT=__SECRET__

# -----------------------------------------------------------------------------
# Developer flags — should always be false in production
# -----------------------------------------------------------------------------

WP_DEBUG=true
WP_DEBUG_DISPLAY=true
WP_DEBUG_LOG=true
SCRIPT_DEBUG=true

# -----------------------------------------------------------------------------
# Caching flags
# -----------------------------------------------------------------------------

WP_CACHE=false

# Should always be true in production
DISALLOW_FILE_EDIT=true

# -----------------------------------------------------------------------------
# Docker compose vars
# -----------------------------------------------------------------------------

# Linux only — uncomment to match your host user/group IDs (run `id -u` / `id -g`)
#USER_ID=1000
#GROUP_ID=1000

# For loopback to work (allowing WP to be able to curl itself)
LOOPBACK_HOST_NAME=${PROJECT_NAME}.local
