#!/usr/bin/env bash

# Exit when any command fails
set -e

# Usage: bin/install --project=[project_name] --network=[docker_network_name] --php=[php_version]
#
# Defaults: project_name = it-mogul, docker_network_name = it-mogul-docker, php_version = 8.3
# All arguments are optional.

# Set defaults
export PROJECT_NAME="it-mogul"
export DOCKER_NETWORK_NAME="it-mogul-docker"
export PHP_VERSION="8.3"
export WORDPRESS_VERSION="6.7"

GREEN='\033[0;32m'
BG_GREEN='\033[42m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Thanks to: https://stackoverflow.com/a/14203146
for i in "$@"; do
  case $i in
    --project=*)
      export PROJECT_NAME="${i#*=}"
      shift # past argument=value
      ;;
    --network=*)
      export DOCKER_NETWORK_NAME="${i#*=}"
      shift # past argument=value
      ;;
    --php=*)
      export PHP_VERSION="${i#*=}"
      shift # past argument=value
      ;;
    -*|--*)
      echo "Unknown option $i"
      exit 1
      ;;
    *)
      ;;
  esac
done

echo 'Setting up .env vars...';

echo -e "Using ${GREEN}${PROJECT_NAME}${NC} for PROJECT_NAME";
echo -e "Using ${GREEN}${DOCKER_NETWORK_NAME}${NC} for DOCKER_NETWORK_NAME";
echo -e "Using ${GREEN}${PHP_VERSION}${NC} for PHP_VERSION";

# Create .env from example if it does not exist
if [ ! -f .env ]; then
  echo 'Creating .env from .env.example...';
  envsubst \$PROJECT_NAME,\$DOCKER_NETWORK_NAME,\$PHP_VERSION,\$WORDPRESS_VERSION < .env.example > .env
fi

# Create docker/app/.env from example if it does not exist
if [ ! -f docker/app/.env ]; then
  echo 'Creating docker/app/.env from docker/app/.env.example...';
  envsubst \$PROJECT_NAME < docker/app/.env.example > docker/app/.env
fi

if [[ "$(docker network ls | grep ${DOCKER_NETWORK_NAME})" == "" ]] ; then
    echo 'Setting up docker network...';
    docker network create --subnet=192.168.36.0/24 $DOCKER_NETWORK_NAME;
fi

echo 'Stopping any running containers...';

docker compose stop;

# Import .env files so we have access to env vars. docker/app/.env will override the root.
. .env;
. ./docker/app/.env;

echo 'Building docker containers...';

docker compose build;
docker compose up -d;

echo 'Running composer install...';

bin/docker/composer install;

# mu-plugins can interfere with the initial installation process, rewrite the directory to disable them temporarily
mv wp-content/mu-plugins wp-content/mu-plugins-disabled

# Add a trap to always move the directory back to its original state, this covers:
# - Normal termination (EXIT)
# - Interrupted (INT)
# - Killed (TERM)
# - Hangup (HUP)
trap '[ -d wp-content/mu-plugins-disabled ] && mv wp-content/mu-plugins-disabled wp-content/mu-plugins' EXIT INT TERM HUP

echo 'Installing WordPress...';

until bin/docker/wp core install --url="${WP_HOME}" --title="${PROJECT_NAME}" --admin_user=admin --admin_email=admin@example.com --skip-email;
do
    echo 'Waiting for the database...';
done

# Manually move the directory back after the installation
mv wp-content/mu-plugins-disabled wp-content/mu-plugins

echo 'Flushing cache...'
bin/docker/wp cache flush;

echo 'Activating theme...';
bin/docker/wp theme activate ${PROJECT_NAME}

clear;
echo -e "${BOLD}";
echo -e "  ___ _     ___   __  __  ___  _   _ _     ";
echo -e " |_ _| |_  / _ \ / _|/ _|/ _ \| | | | |    ";
echo -e "  | || __|| | | | |_| |_| | | | |_| | |    ";
echo -e "  | || |_ | |_| |  _|  _| |_| |  _  | |___ ";
echo -e " |___|\__| \___/|_| |_|  \___/|_| |_|_____|";
echo -e "                                           ";
echo -e "   ____                      _      _      ";
echo -e "  / ___|___  _ __ ___  _ __ | | ___| |_ ___";
echo -e " | |   / _ \| '_ \` _ \| '_ \| |/ _ \ __/ _ \\";
echo -e " | |__| (_) | | | | | | |_) | |  __/ ||  __/";
echo -e "  \____\___/|_| |_| |_| .__/|_|\___|\__\___|";
echo -e "                       |_|                  ";
echo -e "${NC}";

echo -e "${GREEN}Add the following to your hosts file before continuing:${NC} 127.0.0.1 ${PROJECT_NAME}.local"

echo -e "${GREEN}Site administrator.${NC}"
echo -e "The email will be \"admin@example.com\", the password can be set using ${BOLD}./bin/docker/wp user update admin --user_pass=your_password_here${NC}.\n";
echo -e "\n${GREEN}Visit site:";
echo -e "${NC}${WP_HOME}";
echo -e "\n${GREEN}Visit admin:";
echo -e "${NC}${WP_HOME}/wp-admin";
