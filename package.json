{
    "name": "it-mogul-wordpress",
    "version": "1.0.0",
    "description": "The IT Mogul — a reusable WordPress application development foundation.",
    "license": "GPL-2.0-or-later",
    "private": true,
    "workspaces": [
        "wp-content/mu-plugins/*",
        "wp-content/themes/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "start": "turbo run start",
        "format": "turbo run format",
        "lint": "turbo run lint",
        "lint:css": "turbo run lint:css",
        "lint:js": "turbo run lint:js",
        "lint:fix": "turbo run lint:fix",
        "lint:css:fix": "turbo run lint:css:fix",
        "lint:js:fix": "turbo run lint:js:fix",
        "test": "turbo run test",
        "test:unit": "turbo run test:unit"
    },
    "devDependencies": {
        "turbo": "^2.8.20"
    },
    "packageManager": "npm@10.8.1"
}
