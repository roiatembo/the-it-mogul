{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "description": "The IT Mogul — a strong, reusable visual foundation. Editorial, technical, confident and precise.",
    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": false,
            "customDuotone": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "gradients": [],
            "link": true,
            "palette": [
                {
                    "color": "#101010",
                    "name": "Foreground",
                    "slug": "foreground"
                },
                {
                    "color": "#ffffff",
                    "name": "Background",
                    "slug": "background"
                },
                {
                    "color": "#f6f6f4",
                    "name": "Neutral Light",
                    "slug": "neutral-light"
                },
                {
                    "color": "#e7e7e2",
                    "name": "Neutral",
                    "slug": "neutral"
                },
                {
                    "color": "#2b2b28",
                    "name": "Neutral Dark",
                    "slug": "neutral-dark"
                },
                {
                    "color": "#0f7a4d",
                    "name": "Accent",
                    "slug": "accent"
                },
                {
                    "color": "#0a5c3a",
                    "name": "Accent Dark",
                    "slug": "accent-dark"
                },
                {
                    "color": "#e8f4ee",
                    "name": "Accent Light",
                    "slug": "accent-light"
                }
            ]
        },
        "custom": {
            "spacing": {
                "section": "clamp(4rem, 8vw, 7.5rem)",
                "section-tight": "clamp(2.5rem, 5vw, 4.5rem)"
            },
            "layout": {
                "gutter": "clamp(1.25rem, 4vw, 2.5rem)"
            },
            "radius": {
                "small": "4px",
                "medium": "8px",
                "large": "12px"
            }
        },
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "spacing": {
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "padding": true,
            "margin": true,
            "blockGap": true,
            "spacingSizes": [
                {
                    "name": "2XS",
                    "size": "0.5rem",
                    "slug": "2xs"
                },
                {
                    "name": "XS",
                    "size": "0.75rem",
                    "slug": "xs"
                },
                {
                    "name": "Small",
                    "size": "1rem",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "1.5rem",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "2rem",
                    "slug": "large"
                },
                {
                    "name": "XL",
                    "size": "3rem",
                    "slug": "xl"
                },
                {
                    "name": "2XL",
                    "size": "4rem",
                    "slug": "2xl"
                },
                {
                    "name": "3XL",
                    "size": "6rem",
                    "slug": "3xl"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
                    "name": "Inter",
                    "slug": "inter",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStyle": "normal",
                            "fontWeight": "400 700",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/inter/Inter-Variable.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "fluid": {
                        "max": "0.875rem",
                        "min": "0.8125rem"
                    },
                    "name": "Small",
                    "size": "0.8125rem",
                    "slug": "small"
                },
                {
                    "fluid": {
                        "max": "1.0625rem",
                        "min": "1rem"
                    },
                    "name": "Body",
                    "size": "1rem",
                    "slug": "body"
                },
                {
                    "fluid": {
                        "max": "1.25rem",
                        "min": "1.125rem"
                    },
                    "name": "Body Large",
                    "size": "1.125rem",
                    "slug": "body-large"
                },
                {
                    "fluid": {
                        "max": "1.5rem",
                        "min": "1.3125rem"
                    },
                    "name": "H4",
                    "size": "1.3125rem",
                    "slug": "h4"
                },
                {
                    "fluid": {
                        "max": "1.875rem",
                        "min": "1.5rem"
                    },
                    "name": "H3",
                    "size": "1.5rem",
                    "slug": "h3"
                },
                {
                    "fluid": {
                        "max": "2.5rem",
                        "min": "1.875rem"
                    },
                    "name": "H2",
                    "size": "1.875rem",
                    "slug": "h2"
                },
                {
                    "fluid": {
                        "max": "3.5rem",
                        "min": "2.375rem"
                    },
                    "name": "H1",
                    "size": "2.375rem",
                    "slug": "h1"
                },
                {
                    "fluid": {
                        "max": "4.5rem",
                        "min": "2.75rem"
                    },
                    "name": "Display",
                    "size": "2.75rem",
                    "slug": "display"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "elements": {
            "button": {
                "border": {
                    "radius": "var(--wp--custom--radius--small)",
                    "width": "1px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--accent)"
                },
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "var(--wp--preset--color--background)"
                },
                "css": "font-weight: 600; letter-spacing: 0.01em; padding: 0.875rem 1.5rem; transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease; cursor: pointer;",
                "spacing": {
                    "padding": {
                        "top": "0.875rem",
                        "right": "1.5rem",
                        "bottom": "0.875rem",
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body)",
                    "fontWeight": "600"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--accent-dark)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--accent-dark)"
                    }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var(--wp--preset--color--accent)",
                        "style": "solid",
                        "width": "2px"
                    },
                    "outlineOffset": "2px"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--accent)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--accent-dark)"
                    }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var(--wp--preset--color--accent)",
                        "style": "solid",
                        "width": "2px"
                    },
                    "outlineOffset": "2px"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--foreground)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontWeight": "700",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.02em"
                }
            },
            "caption": {
                "color": {
                    "text": "var(--wp--preset--color--neutral-dark)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            }
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--medium)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "var(--wp--preset--font-size--body)",
            "lineHeight": "1.65"
        },
        "blocks": {
            "core/paragraph": {
                "typography": {
                    "lineHeight": "1.7"
                }
            },
            "core/heading": {
                "typography": {
                    "lineHeight": "1.15"
                }
            },
            "core/group": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--medium)"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": {
                        "left": "var(--wp--preset--spacing--large)",
                        "right": "var(--wp--preset--spacing--large)"
                    }
                }
            },
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--accent)",
                        "style": "solid",
                        "width": "3px"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--medium)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body-large)",
                    "fontStyle": "normal",
                    "fontWeight": "500",
                    "lineHeight": "1.5"
                }
            },
            "core/list": {
                "spacing": {
                    "padding": {
                        "left": "1.25rem"
                    }
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--neutral)"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body)",
                    "fontWeight": "500"
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
